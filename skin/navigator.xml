<?xml version="1.0" encoding="UTF-8"?>
<Skin>

	<Styles>
		<Style name="TextLinkStyle" inherit="Standard.Label">
			<Color name="textcolor" color="@Main.LabelColor"/>
		</Style>

		<Style name="HeaderTextStyle" inherit="Standard.Label">
			<Font name="textfont" themeid="StandardUI" size="+6"/>
			<Color name="textcolor" color="@Main.LabelColor"/>
			<Metric name="padding.left"     value="1"/>
		</Style>

		<Style name="BodyTextStyle" inherit="Standard.Label">
			<Color name="textcolor" color="@Main.LabelColor.Secondary"/>
		</Style>

		<Style name="BodyLinkTextStyle" inherit="Standard.Label">
			<Color name="textcolor" color="@Main.HyperLinkColor"/>
		</Style>

		<Style name="DemoButton" inherit="Standard.Button">
			<Metric name="colorize.icon" value="1"/>
			<Color name="iconcolor" color="@Main.LabelColor"/>
			<Color name="iconcolor.disabled" color="@Main.LabelColor.Disabled"/>
			<Color name="iconcolor.mouseover" color="@Main.LabelColor.Primary"/>
			<Metric name="fill.icon" value="0.75"/>
		</Style>

		<Style name="AppMenu" inherit="Standard.SelectBox">
			<Metric name="extended" value="1"/>
		</Style>

	</Styles>

	<Forms>
	    <!-- ******************************************************************************************** -->
	    <!-- Navigator -->
	    <!-- ******************************************************************************************** -->

		<Form name="Navigator" attach="all">
			<Vertical margin="0" spacing="0" width="800" attach="all">
				<View name="NavigationBar" width="800" attach="left right"/>
				<View name="contentFrame" width="800" height="600" sizelimits="none" attach="all"/>
			</Vertical>
		</Form>

		<Form name="NavigationBar" attach="top left right">
			<Horizontal spacing="5" margin="5" attach="left right">
				<DialogGroup options="secondary" attach="left right">
					<Horizontal spacing="0" margin="0" attach="left right">
						<Button name="goHome"    icon="Mdi/HomeOutline" style="DemoButton" size="0,0,50,40" options="transparent" tooltip="Start Page"/>
						<Button name="goBack"    icon="Mdi/ChevronLeft" style="DemoButton" size="0,0,50,40" options="transparent" tooltip="Back"/>
						<Button name="goForward" icon="Mdi/ChevronRight" style="DemoButton" size="0,0,50,40" options="transparent" tooltip="Forward"/>
						<Button name="refresh"   icon="Mdi/Refresh" style="DemoButton" size="0,0,50,40" options="transparent" tooltip="Refresh"/>
						<!--
						<TextBox name="location" size="0,0,300,20"/>
						-->
						<Space attach="left right"/>

						<SelectBox name="object://hostapp/Application/applicationMenu" style="AppMenu" tooltip="Application Menu" size="0,0,40,40" popup="right bottom" options="transparent hidebutton hidefocus">
							<Button icon="Mdi/Menu" style="DemoButton" size="0,0,40,40" options="passive transparent" tooltip="Application Menu"/>
						</SelectBox>
					</Horizontal>
				</DialogGroup>
			</Horizontal>
		</Form>

		<!-- ******************************************************************************************** -->
		<!-- Demo Index Page -->
		<!-- ******************************************************************************************** -->

		<Form name="DemoIndex" attach="all">
			<Vertical margin="0" spacing="0" attach="all">
				<ScrollView width="800" options="autohideboth extendtarget transparent" scrolloptions="notiledlayers" attach="all">
					<Target name="DemoIndex.Target" options="transparent" attach="all"/>
				</ScrollView>
				<TextBox name="object://ccldemo/Application/appNameAndVersion" attach="fitsize hcenter bottom" options="transparent"/>
			</Vertical>
		</Form>

		<Form name="DemoIndex.Target" options="transparent">
			<Horizontal margin="0" spacing="0" attach="all fill">
				<Space attach="left right fill"/>				
				<Vertical margin="0" spacing="5" attach="hcenter">
					<Space/>
					<Label title="Select a category or demo" style="HeaderTextStyle"/>
					<Space/>
					<foreach variable="$index" count="resultCount">
						<define resultId="@property:resultId[$index]" resultTitle="@property:resultTitle[$index]" resultForm="@property:resultForm[$index]">
						<Anchor url="object://ccldemo/Demo?id=$resultId">
							<Link title="$resultTitle" size="2,0" style="TextLinkStyle" attach="left"/>
							<View name="$resultForm.Summary" attach="left right"/>
						</Anchor>
						<Space height="5"/>
						</define>
					</foreach>
					<Space/>
				</Vertical>			
				<Space attach="left right fill"/>
			</Horizontal>
		</Form>

		<!-- ******************************************************************************************** -->
		<!-- Demo Page -->
		<!-- ******************************************************************************************** -->

		<Form name="DemoPage.Scrollable" attach="all">
			<ScrollView options="small vertical horizontal mousescroll transparent extendtarget" attach="all">
				<Target name="DemoPage.Static" options="transparent" attach="left right vfit"/>
			</ScrollView>
		</Form>

		<Form name="DemoPage.Static" options="transparent" attach="all">
			<Vertical margin="0" spacing="0" attach="all" options="unifysizes">
				<!-- Demo Header -->
				<Vertical margin="10" spacing="0" attach="all" options="unifysizes">
					<using controller="DemoInfo">
						<TextBox name="demoTitle" options="transparent" attach="fitsize" style="HeaderTextStyle"/>
						<Table margin="0" spacing="1" columns="2">
							<Label title="Source:" attach="vcenter"/>
							<Link name="demoSourceFileLink">
								<TextBox name="demoSourceFileName" options="transparent" attach="fitsize" style="BodyLinkTextStyle"/>
							</Link>
							<Label title="Skin XML:" attach="vcenter"/>
							<Link name="demoSkinFileLink">
								<TextBox name="demoSkinFileName" options="transparent" attach="fitsize" style="BodyLinkTextStyle"/>
							</Link>
						</Table>
					</using>

					<View name="$demoFormName.Summary" attach="left right vfit"/>
				</Vertical>

				<!-- Demo Content -->
				<View name="$demoFormName" attach="all"/>
			</Vertical>
		</Form>


	</Forms>
</Skin>
