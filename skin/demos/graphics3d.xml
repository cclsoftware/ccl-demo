<?xml version="1.0" encoding="UTF-8"?>
<Skin>

	<Resources>
		<Model3D name="DemoModel" url="3d/demo.obj"/>
		<Image name="DemoTexture" url="images/Voodoo.png"/>
		<Image name="OutlineTexture" url="images/outline.png"/>		
	</Resources>

	<Styles>
		<Style name="DemoScene">
			<String name="camera" value="cam1"/>
			<Metric name="multisamplingfactor" value="8"/>
		</Style>
	</Styles>

	<Forms>

		<Form name="Graphics.Graphics 3D.Summary" attach="all">
			<Label title="3D scene rendering."/>
		</Form>

		<Form name="Graphics3DControl">
			<Horizontal margin="0" spacing="4" attach="left right">
				<if defined="$title">
					<Label title="$title" attach="vcenter" width="35"/>
				</if>
				<ValueBox name="$param" attach="vcenter" width="50"/>
				<!--
				<Slider name="$param" options="horizontal" width="200" attach="vcenter left right"/>
				-->
			</Horizontal>
		</Form>

		<Form name="Graphics.Graphics 3D" attach="all">
			<Horizontal margin="0" spacing="0" attach="all">
				<Vertical margin="10" spacing="5" sizelimits="-1,-1,500,-1" options="unifysizes" attach="all fill">

					<Table margin="0" columns="1" cellratio="1" attach="all">
						<View attach="all">
							<using controller="DemoSceneComponent">
								<View name="UserSceneView3D" width="300" height="260" attach="all">
									<SceneView3D name="Scene" width="300" height="260" style="DemoScene" attach="all"/>
								</View>
							</using>
							<Variant name="user3D" width="100" height="100">
								<View name="UserView3D" width="100" height="100"/>
							</Variant>
						</View>
					</Table>
					<ScrollView options="autohideboth transparent small" width="308" attach="all">
						<Target name="Graphics3DControls" options="transparent" attach="left right"/>
					</ScrollView>
				</Vertical>
				<Space width="1" attach="left right"/>
			</Horizontal>
		</Form>

		<Form name="Graphics3DControls" options="transparent" attach="left right">
			<Vertical margin="0" spacing="5" width="300" sizelimits="-1,-1,500,-1" options="unifysizes" attach="left right">

				<Label title="Visibility"/>
				<SwipeBox target="CheckBox" attach="left right">
					<Table margin="0" columns="3" width="300" sizelimits="-1,-1,500,-1" attach="left right">
						<CheckBox name="user3D" title="UserView3D" attach="left right"/>
						<using controller="DemoSceneComponent">
							<CheckBox name="outlineCube" title="Outline Cube" attach="left right"/>
							<CheckBox name="grid" title="Grid" attach="left right"/>
							<CheckBox name="transparentCube" title="Transparent Cube" attach="left right"/>
							<CheckBox name="billboard" title="Billboard" attach="left right"/>
							<CheckBox name="sphere" title="Sphere" attach="left right"/>
							<CheckBox name="textBillboard" title="Text Billboard" attach="left right"/>
							<CheckBox name="teapot" title="Teapot" attach="left right"/>
							<Button name="animate" title="Animate"/>
						</using>
					</Table>
				</SwipeBox>

				<using controller="DemoSceneComponent">
					<Horizontal margin="0">
						<Vertical margin="0">
							<Label title="Camera Position"/>
							<define title="X:" param="cameraPosX"><View name="Graphics3DControl" attach="left right"/></define>
							<define title="Y:" param="cameraPosY"><View name="Graphics3DControl" attach="left right"/></define>
							<define title="Z:" param="cameraPosZ"><View name="Graphics3DControl" attach="left right"/></define>
						</Vertical>
						<Vertical margin="0">
							<Label title="Camera Orientation"/>
							<define title="Yaw:" param="cameraYawAngle"><View name="Graphics3DControl" attach="left right"/></define>
							<define title="Pitch:" param="cameraPitchAngle"><View name="Graphics3DControl" attach="left right"/></define>
							<define title="Roll:" param="cameraRollAngle"><View name="Graphics3DControl" attach="left right"/></define>
						</Vertical>
						<Vertical margin="0">
							<Label title="Field of View"/>
							<define title="Angle:" param="cameraFieldOfViewAngle"><View name="Graphics3DControl" attach="left right"/></define>
						</Vertical>
					</Horizontal>
				</using>
				
			</Vertical>
		</Form>

	</Forms>
</Skin>

