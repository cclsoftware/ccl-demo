<?xml version="1.0" encoding="UTF-8"?>
<Skin>
	<Styles>
		<Style name="DemoTextEditor" inherit="Standard.Label">
			<Color name="backcolor"        	color="@Main.EditBoxBackColor"/>
			<Color name="selectioncolor"   	color="@Main.TextSelectionBackColor"/>
			<Align name="textalign" align="left top"/>
		</Style>
	</Styles>

	<Forms>

		<Form name="Controls.BlockView.Summary" attach="all">
			<Label title="BlockView with Markdown."/>
		</Form>

		<Form name="Controls.BlockView" attach="all">
			<Vertical attach="all">

				<Horizontal margin="0" attach="all" options="unifysizes">
					<Vertical margin="0" attach="all">
						<Label title="Markdown Source:"/>
						<TextEditor name="markdownSource" size="0,0,150,300" style="DemoTextEditor" options="hidefocus dragtext extended small" attach="all"/>
					</Vertical>

					<Vertical margin="0" attach="all">
						<Label title="Result in BlockView:"/>
						<ImageView style="BlockViewStyle" attach="all">
							<BlockView name="blockContent" size="0,0,150,300" options="small" attach="all"/>
						</ImageView>
					</Vertical>
				</Horizontal>

			</Vertical>
		</Form>

	</Forms>
</Skin>

