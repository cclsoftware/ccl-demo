<?xml version="1.0" encoding="utf-8"?>
<Skin>
	
	<Resources>		
		<Image name="AppIcon" url="images/AppIcon.png"/> <!-- icon for about screen -->
		<Image name="AppNotifyIcon" url="images/TrayIcon.png"/> <!-- icon for notifications -->
	</Resources>

    <Styles>
		<Style name="AboutLabel" inherit="Standard.Label">
			<Metric name="padding.left"	value="0"/>
		</Style>		
		<Style name="LicenseText" inherit="Standard.Label">
			<Align name="textalign" align="top left"/>
		</Style>		
	</Styles>

	<Forms>
		<!-- ******************************************************************************************** -->
		<!-- Application Window -->
		<!-- ******************************************************************************************** -->
		
		<Form name="ApplicationWindow" sizelimits="80,80,-1,-1" attach="all" options="colorize" style="Standard.WindowBackground">
			<using controller="object://ccldemo/Navigator">
				<View name="Navigator" attach="all"/>
			</using>
		</Form>

		<!-- ******************************************************************************************** -->
        <!-- About -->
        <!-- ******************************************************************************************** -->
		
		<?xstring off?>

		<Form name="AboutApplication" title="About $APPNAME" attach="all fitsize">
			<Variant property="isPortraitOrientation" controller="://WindowManager" attach="all fitsize">
				<Horizontal margin="20">
					<ImageView image="AppIcon"/>
					<View name="AboutApplicationContent" width="370"/>
				</Horizontal>
				<Vertical attach="left right vfit">
					<ImageView image="AppIcon" attach="hcenter"/>
					<View name="AboutApplicationContent" attach="left right vfit"/>
				</Vertical>
			</Variant>
		</Form>

		<Form name="AboutApplicationContent">
			<Vertical attach="left right vfit" spacing="0">
				<TextBox name="appNameAndVersion" width="300" sizelimits="300,32,-1,-1" options="transparent multiline" style="AboutLabel" attach="left right vfit"/>
				<Label title="Demo Application for $CCLNAME&reg;" width="300" style="AboutLabel"/>
				<Space/>
				<Label title="Copyright &copy; $COPYYEAR $CCLAUTHOR. All Rights Reserved" width="300" style="AboutLabel" options="multiline" attach="left right vfit"/>
				<Space/>
				<Space/>
				<Anchor url="https://ccl.dev">
					<Link title="For more information, please visit ccl.dev." width="300" style="AboutLabel" attach="left right"/>
				</Anchor>
				<Link title="Third-party software used in this product" command.category="Help" command.name="Legal Information" width="300" height="20" style="AboutLabel" options="fittitle" attach="left right"/>
				<Space/>
				<Space/>
				<Label title="Made with &hearts; in Hamburg, Germany" width="300" style="AboutLabel"/>
			</Vertical>
		</Form>
		<?xstring?>
		
		<!-- ******************************************************************************************** -->
        <!-- Legal Information -->
        <!-- ******************************************************************************************** -->
		
		<Form name="LegalInformation" title="License Information" size="0,0,400,460" options="transparent translucent windowmovable" attach="all">
			<TextEditor name="licenseText" options="small multiline transparent" size="10,10,380,440" style="LicenseText" attach="all"/>
		</Form>		
		
	</Forms>
		
</Skin>

